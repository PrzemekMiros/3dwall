<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f7f7f5"><meta name="description" content="{{ site.description }}"><title>{{ site.title }}</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='27' fill='%23ef634f'/%3E%3C/svg%3E">
  <style>
    :root{--red:#ef634f;--ink:#111;--unit:58vw}*{box-sizing:border-box}html,body{margin:0;background:#eee;color:var(--ink);font-family:"Arial Narrow","Helvetica Neue",Arial,sans-serif;overflow-x:hidden}body{height:1820vh}button,a,input,textarea{font:inherit;color:inherit}
    .viewport{position:fixed;inset:0;overflow:hidden;background:#fafafa;perspective:1050px;isolation:isolate}.ceiling,.floor{position:absolute;left:0;width:100%;z-index:12;pointer-events:none}.ceiling{top:0;height:17.5vh;background:repeating-linear-gradient(90deg,#ddd9d2 0 15vw,#fff 15vw 24vw);clip-path:polygon(0 0,100% 0,93% 100%,7% 100%);box-shadow:0 18px 40px rgba(20,20,20,.08)}.ceiling:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.07),transparent 12%,transparent 88%,rgba(0,0,0,.07))}.floor{bottom:0;height:17vh;background:repeating-linear-gradient(92deg,rgba(75,51,27,.13) 0 1px,transparent 1px 13vw),linear-gradient(#c9b28e,#a9885e);clip-path:polygon(7% 0,93% 0,100% 100%,0 100%);box-shadow:inset 0 12px 30px rgba(53,38,21,.18)}.floor:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.4),transparent 15%,rgba(255,255,255,.2) 48%,transparent 75%)}
    .world{position:absolute;left:0;top:12vh;height:76vh;display:flex;align-items:stretch;transform-style:preserve-3d;will-change:transform;z-index:2}.wall{width:var(--unit);height:76vh;flex:0 0 var(--unit);position:relative;background:linear-gradient(90deg,#eee 0,#fafafa 12%,#f5f5f3 88%,#e8e8e6 100%);display:flex;align-items:center;padding:7vh 5vw;overflow:hidden;border-left:1px solid rgba(0,0,0,.035)}.wall:after{content:"";position:absolute;top:0;right:-8vw;width:15vw;height:100%;background:linear-gradient(90deg,rgba(0,0,0,.07),transparent 75%);transform:skewY(-14deg);pointer-events:none}.bend{width:25vw;height:76vh;flex:0 0 25vw;background:linear-gradient(115deg,#d8d8d5 0,#f9f9f7 49%,#d6d6d3 50%,#f2f2f0 100%);clip-path:polygon(27% 0,100% 0,73% 100%,0 100%);box-shadow:inset 20px 0 35px rgba(0,0,0,.06),inset -18px 0 30px rgba(0,0,0,.05)}.room{width:48vw;height:76vh;flex:0 0 48vw;position:relative;background:linear-gradient(90deg,#ececea,#fff 30%,#f0f0ee 70%,#dededb);display:grid;place-items:center}.room:before,.room:after{content:"";position:absolute;top:16%;width:18px;height:48px;background:linear-gradient(#222 0 32%,#f2f2ee 33% 100%);box-shadow:0 4px 16px #fff}.room:before{left:7%}.room:after{right:7%}.plinth{width:11vw;height:18vh;background:linear-gradient(120deg,#eee,#cfcfcb);box-shadow:0 13px 18px rgba(0,0,0,.12);display:grid;place-items:center;color:var(--red);font-size:5rem;font-weight:900;transform:perspective(500px) rotateY(-5deg)}.plant{position:absolute;bottom:8%;font-size:5rem;filter:saturate(.65)}.plant.left{left:10%}.plant.right{right:8%}
    .hero{width:100%;display:grid;grid-template-columns:1.65fr .72fr;gap:3vw;align-items:end}.hero h1,.contact-title{font-family:Impact,"Arial Narrow",sans-serif;color:var(--red);font-size:clamp(4.2rem,7.7vw,9.4rem);font-weight:900;letter-spacing:-.045em;line-height:.79;text-transform:uppercase;margin:0;text-shadow:0 .08em 0 rgba(0,0,0,.12),.03em .03em 0 rgba(239,99,79,.2)}.hero-side{padding-bottom:1vh}.hero-side p{font-family:cursive;font-size:clamp(.85rem,1.08vw,1.25rem);line-height:1.18;transform:rotate(-2deg);margin:0 0 22px}.btn{display:inline-flex;border:0;background:#111;color:#fff;padding:11px 24px;text-decoration:none;font-weight:700;font-size:.82rem;cursor:pointer}.outline{background:transparent;color:#111;border:1px solid #111}.doodle{position:absolute;font-family:cursive;font-weight:900;font-size:1.15rem;transform:rotate(-8deg)}.wow{left:7%;top:17%;border:3px solid;padding:8px;border-radius:50%}.bubble{right:6%;top:18%;border:2px solid;padding:9px 13px;border-radius:48%}
    .intro{width:100%;max-width:540px;margin:auto}.icon{font-size:4rem;line-height:1;margin-bottom:18px}.intro h2{font-size:clamp(2.7rem,4.4vw,5rem);font-weight:500;letter-spacing:-.065em;line-height:.9;margin:0 0 22px}.intro p,.service p,.copy p,.case p{font-family:Arial,sans-serif;font-size:clamp(.86rem,1vw,1.08rem);line-height:1.55;color:#323232}.arrow-doodle{position:absolute;left:5%;bottom:20%;font-size:4rem;transform:rotate(18deg)}
    .services{align-items:flex-end;padding-bottom:12vh}.service{width:100%}.num{font-size:.8rem;font-weight:700;margin-bottom:9px}.service h3{font-size:clamp(2.2rem,3vw,4rem);font-weight:400;letter-spacing:-.055em;margin:0 0 25px;line-height:.94}.service p{max-width:360px;margin-bottom:38px}.service .outline{padding:10px 22px}.prompt{align-items:center;justify-content:center;text-align:center}.prompt p{font-family:cursive;font-size:clamp(1.3rem,2.4vw,2.8rem);font-weight:700;line-height:1.05;transform:rotate(-3deg);margin-bottom:28px}
    .gallery-room{width:62vw;flex-basis:62vw}.display{width:74%;height:54%;background:#111;border:12px solid #d7d7d4;box-shadow:0 14px 28px rgba(0,0,0,.18);position:relative;overflow:hidden}.display:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 54% 43%,#fff 0 5%,transparent 5.4%),linear-gradient(135deg,#06192b,#44258e 43%,#e4466d 70%,#0fb4a3)}.display:after{content:"SHOWREEL";position:absolute;left:50%;bottom:8%;transform:translateX(-50%);color:var(--red);font:900 2.2rem Impact}.copy{width:100%}.copy h2{font-size:clamp(2.6rem,4vw,5rem);font-weight:400;letter-spacing:-.06em;margin:0 0 20px}.copy p{max-width:480px}.copy .btn{margin-top:18px}.mini-doodle{font-size:3.5rem;position:absolute;bottom:15%;right:8%;transform:rotate(8deg)}
    .cases{padding-left:3vw;padding-right:3vw}.case{width:100%;display:grid;grid-template-columns:1.15fr .85fr;gap:3vw;align-items:center}.art{height:42vh;box-shadow:0 12px 25px rgba(0,0,0,.14);border:10px solid #e0e0dc;position:relative;overflow:hidden}.art.a{background:linear-gradient(145deg,#c9ffdf,#fff 43%,#58d99f)}.art.b{background:linear-gradient(145deg,#090b12,#392a5e 48%,#e4a52c)}.art.c{background:linear-gradient(145deg,#e8fbff,#cfe7f2 50%,#fff)}.art.d{background:linear-gradient(145deg,#06161c,#05453f 48%,#27d3aa)}.art:after{content:"";position:absolute;inset:18%;border:2px solid rgba(255,255,255,.8);box-shadow:30px 20px 0 rgba(255,255,255,.28),-20px -14px 0 rgba(0,0,0,.12)}.case h3{font-size:clamp(2.3rem,3.7vw,4.6rem);font-weight:400;letter-spacing:-.06em;margin:0 0 15px}.case p{max-width:360px}.case .outline{margin-top:15px}
    .game-room{width:60vw;flex-basis:60vw}.game-room .slogan{color:var(--red);font:900 clamp(3rem,5vw,6rem)/.88 Impact;text-transform:uppercase;text-align:center;text-shadow:0 .08em 0 rgba(0,0,0,.12)}.bench{position:absolute;bottom:8%;width:58%;height:12px;background:#5d3c24;box-shadow:0 16px 0 -4px #3a2416}.bench:before,.bench:after{content:"";position:absolute;top:8px;width:6px;height:90px;background:#2e2117}.bench:before{left:10%}.bench:after{right:10%}.about{width:100%;max-width:610px;margin:auto}.about h2{font-size:clamp(3rem,4.7vw,5.6rem);font-weight:400;letter-spacing:-.07em;margin:0 0 24px}.about p{font-family:Arial,sans-serif;line-height:1.58}.globe{font-size:7rem;filter:saturate(.8)}
    .contact{width:100%;display:grid;grid-template-columns:.82fr 1.18fr;gap:4vw;align-items:center}.contact-title{font-size:clamp(4rem,6.3vw,8rem)}form{display:grid;gap:22px}label{font-size:.75rem;font-family:Arial,sans-serif}input,textarea{display:block;width:100%;border:0;border-bottom:1px solid #bbb;background:transparent;padding:8px 0;outline:none}textarea{height:78px;resize:none}.send{justify-self:end}
    .logo{position:fixed;z-index:30;left:18px;top:12px;font-weight:900;font-size:1.35rem;letter-spacing:-.11em;text-decoration:none}.logo i{display:inline-block;width:8px;height:8px;background:var(--red);border-radius:50%;margin:0 1px}.top-ui{position:fixed;z-index:30;right:18px;top:12px;display:flex;gap:6px}.sq,.hire{height:30px;border:0;background:#111;color:white;font-size:.67rem;padding:0 10px;border-radius:4px}.sq{width:30px;padding:0;font-size:.9rem}.social{position:fixed;z-index:30;left:18px;bottom:10px;display:flex;gap:24px;font-size:.62rem}.chain{position:fixed;z-index:30;bottom:8px;left:50%;transform:translateX(-50%);width:36px;height:36px;background:#222;color:#fff;border-radius:50%;display:grid;place-items:center;font-size:1.05rem}.scroll-note{position:fixed;z-index:30;right:3.5vw;bottom:15vh;font-family:cursive;font-size:.8rem;transform:rotate(-5deg)}.mobile-progress{display:none}
    @media(max-width:760px){body{height:auto;overflow:auto}.viewport{position:relative;overflow:hidden;perspective:none}.ceiling,.floor,.scroll-note{display:none}.world{position:relative;top:0;height:auto;display:block;transform:none!important}.wall,.room{width:100%;height:auto;min-height:100svh;clip-path:none;display:flex;flex-basis:auto;padding:110px 25px 80px}.bend{display:none}.wall:after{display:none}.hero{display:block}.hero h1{font-size:4.25rem}.hero-side{margin-top:42px}.services{align-items:center}.room{min-height:76svh}.plinth{width:38vw}.case,.contact{display:block}.art{height:40vh;margin-bottom:35px}.game-room{width:100%}.social,.chain{display:none}.top-ui{right:12px}.logo{left:12px}.mobile-progress{display:block;position:fixed;right:0;top:0;width:4px;height:100%;background:rgba(0,0,0,.08);z-index:40}.mobile-progress i{display:block;background:var(--red);width:100%;height:0}}@media(prefers-reduced-motion:reduce){.world{transition:none!important}}
  </style>
